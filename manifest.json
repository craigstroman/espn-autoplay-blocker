{
  "manifest_version": 3,
  "name": "Stop ESPN Video Autoplay",
  "version": "1.0.0",
  "description": "Prevents ESPN videos from automatically playing.",

  "permissions": ["tabs"],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ]
}
